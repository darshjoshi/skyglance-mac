# SwiftPM
.build/
.swiftpm/
# Package.resolved is deliberately NOT ignored. It was noise while the package
# had no dependencies; now it pins the exact Sparkle revision that gets signed
# into the app and handed to people as an updater, and a release built from an
# unpinned range is a release nobody can reproduce.

# build-app.sh output
build/
*.zip

# Runtime caches (server.mjs writes .cache/, the Mac app writes to
# ~/Library/Application Support/SkyGlance — neither belongs in git)
.cache/

# Agent / tooling scratch
.playwright-mcp/

# macOS
.DS_Store
